# SERVER CONFIGURATION
PORT=3001
NODE_ENV=development

# DATABASE (Optional - leave blank for offline/local mode)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/youtube-content-os?retryWrites=true&w=majority

# CLOUDINARY STORAGE (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=youtube_content_os

# AI PROVIDERS
# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_API_TYPE=ai-studio

# Vertex AI (used when GEMINI_API_TYPE=vertex-ai)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional legacy provider adapters. Set a current model explicitly if you use them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# FALLBACK SETTINGS
ENABLE_LOCAL_STORAGE_FALLBACK=true
MAX_BASE64_IMAGE_SIZE_MB=2
